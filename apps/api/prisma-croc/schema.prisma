generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-croc"
}

datasource db {
  provider = "postgresql"
  url      = env("CROC_DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  exercises       Exercise[]
  weeklyPlans     WeeklyPlan[]
  workoutSessions WorkoutSession[]

  @@map("users")
}

model Exercise {
  id               String           @id // UUID generated by client
  userId           String?          // NULL for system exercises, non-null for custom
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  isTechnique      Boolean          @default(false)
  isCustom         Boolean          @default(false)
  imageAsset       String?
  instructions     String?
  targetMuscles    String[]
  bodyType         String           // UpperBody, CoreBody, LowerBody
  level            String           // Beginner, Intermediate, Advanced
  metricType       String           // Reps, WeightedReps, Hold
  referenceUrl     String?
  milestoneGoal    String?
  milestoneMetric  Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  isDeleted        Boolean          @default(false)
  
  workoutSessions  WorkoutSession[]
  weeklyPlans      WeeklyPlan[]     @relation("WeeklyPlanActiveTechniques")

  @@map("exercises")
}

model WeeklyPlan {
  id               String           @id // UUID generated by client
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate    DateTime
  isArchived       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  isDeleted        Boolean          @default(false)
  
  activeTechniques Exercise[]       @relation("WeeklyPlanActiveTechniques")
  days             WorkoutDay[]

  @@map("weekly_plans")
}

model WorkoutDay {
  id                 String     @id // UUID generated by client
  weeklyPlanId       String
  weeklyPlan         WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  dayOfWeek          Int        // 1 = Monday, 7 = Sunday
  isRestDay          Boolean    @default(false)
  plannedExerciseIds String[]   // Array of Exercise UUIDs

  @@map("workout_days")
}

model WorkoutSession {
  id          String      @id // UUID generated by client
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  date        DateTime
  isCompleted Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isDeleted   Boolean     @default(false)
  
  sets        SetRecord[]

  @@map("workout_sessions")
}

model SetRecord {
  id               String         @id // UUID generated by client
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  reps             Int?
  weight           Float?         // kg
  duration         Int?           // seconds

  @@map("set_records")
}
